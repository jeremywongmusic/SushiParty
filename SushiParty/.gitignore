# Unity.
#
# What must be committed: Assets/, Packages/ and ProjectSettings/. Everything ignored
# below is regenerated by the editor from those three.

# Generated and machine-local
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore a .meta whose asset is committed — an asset without its .meta gets a
# fresh GUID on the next machine and every reference to it breaks.
!/[Aa]ssets/**/*.meta

# Project and solution files. Unity rewrites these on open, from the .asmdef files.
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# IDE state (.vscode is committed on purpose — it is Unity's generated
# files.exclude list plus the recommended extension, not per-user state)
/.vs/
/.idea/
/.gradle/
/.consulo/
/ExportedObj/
.vsconfig

# Player builds
*.apk
*.aab
*.unitypackage
*.app
sysinfo.txt
crashlytics-build.properties

# Addressables
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- FMOD for Unity -------------------------------------------------------------
# The integration itself (Assets/Plugins/FMOD) is committed; only what it generates
# is not.

# Rebuilt by the integration whenever it rescans the Studio project
/[Aa]ssets/[Pp]lugins/FMOD/Cache/
/[Aa]ssets/[Pp]lugins/FMOD/Cache.meta
/[Aa]ssets/[Pp]lugins/FMOD/obj/

# Banks the integration copies in from ../SushiPartyAudio/Build. Build output twice
# over, so they are not tracked here either.
/[Aa]ssets/[Ss]treamingAssets/**/*.bank
/[Aa]ssets/[Ss]treamingAssets/**/*.bank.meta

fmod_editor.log
fmod.log
